# Token de ton bot Telegram (obligatoire)
TELEGRAM_TOKEN=1234567890:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Fuseau horaire utilisé pour les heures de signal et les bilans
# Exemples : Europe/Paris, Africa/Abidjan, Africa/Casablanca, UTC
TIMEZONE=Africa/Abidjan

# Fichier où sont sauvegardées les données (historiques, sessions VIP, etc.)
# Les données survivent désormais à un redémarrage du bot.
PERSISTENCE_FILE=bot_data.pickle

# Liste des chat_id autorisés à utiliser le bot, séparés par des virgules.
# Laisser vide = bot ouvert à tout le monde.
# Pour connaître ton chat_id, tu peux utiliser le bot @userinfobot sur Telegram.
ALLOWED_CHAT_IDS=

# Ton chat_id, pour recevoir les messages des visiteurs et utiliser /broadcast.
# Si non défini et qu'un seul ALLOWED_CHAT_IDS est configuré, il sera utilisé automatiquement.
ADMIN_CHAT_ID=

# ID du groupe de support avec Topics activés (optionnel, mais recommandé).
# Crée un supergroupe Telegram, active "Sujets/Topics" dans ses paramètres, ajoute le bot
# comme admin avec le droit "Gérer les sujets", puis renseigne son id ici (nombre négatif,
# ex: -1001234567890). Chaque visiteur aura alors son propre fil de discussion.
# Laisser vide = relais en message privé simple (mode précédent).
SUPPORT_GROUP_ID=

# Canal Telegram à recommander aux visiteurs qui ne sont pas encore abonnés (optionnel).
# Le bot doit être administrateur du canal pour pouvoir vérifier qui y est abonné.
# @username pour un canal public, ou id numérique négatif pour un canal privé.
CHANNEL_CHAT_ID=

# Lien affiché sur le bouton "Rejoindre le canal".
# Laisser vide si CHANNEL_CHAT_ID est un @username public (déduit automatiquement) ;
# sinon (canal privé), mets ici ton lien d'invitation (ex: https://t.me/+AbCdEfGhIjK).
CHANNEL_INVITE_LINK=

# Réinitialisation automatique quotidienne (optionnelle, désactivée par défaut)
DAILY_RESET_ENABLED=false
DAILY_RESET_HOUR=0

# Timeouts réseau en secondes (augmente si connexion mobile lente/instable)
CONNECT_TIMEOUT=20
READ_TIMEOUT=20

# Canaux/groupes où le bot peut diffuser (bouton "📤 DIFFUSER"), séparés par des virgules.
# Formats acceptés : @moncanal (public) ou -1001234567890 (id numérique, privé).
# Le bot doit être administrateur de chacun d'eux (droit de publication).
# Laisser vide = le bouton DIFFUSER indiquera qu'aucune cible n'est configurée.
BROADCAST_TARGETS=

# Emojis Telegram Premium animés (optionnel). Ne s'applique que si l'admin choisit PREMIUM
# au démarrage du bot ET que Telegram confirme ce statut.
# Format : "emoji:emoji_id" séparés par des virgules, ex : ✅:5368324170671202286,❌:5368324170671202287
# Récupère chaque emoji_id via un bot comme @idcheckbot (envoie-lui l'emoji premium voulu).
PREMIUM_EMOJI_MAP=
