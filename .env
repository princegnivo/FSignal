# Token de ton bot Telegram (obligatoire)
TELEGRAM_TOKEN=1234567890:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Fuseau horaire utilisé pour les heures de signal et les bilans
# Exemples : Europe/Paris, Africa/Abidjan, Africa/Casablanca, UTC
TIMEZONE=Africa/Abidjan

# Fichier où sont sauvegardées les données (historiques, sessions VIP, etc.)
# Les données survivent désormais à un redémarrage du bot.
PERSISTENCE_FILE=bot_data.pickle

# Liste des chat_id autorisés à utiliser le bot, séparés par des virgules.
# Laisser vide = bot ouvert à tout le monde.
# Pour connaître ton chat_id, tu peux utiliser le bot @userinfobot sur Telegram.
ALLOWED_CHAT_IDS=

# Réinitialisation automatique quotidienne (optionnelle, désactivée par défaut)
DAILY_RESET_ENABLED=false
DAILY_RESET_HOUR=0
